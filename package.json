{
  "name": "noctua-ide",
  "version": "0.2.2",
  "description": "NOCTUA — IDE de investigación de seguridad para Kali Linux",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test tests/",
    "postinstall": "node scripts/postinstall.js",
    "rebuild": "electron-rebuild -f -o node-pty",
    "build": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "monaco-editor": "^0.52.0",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@electron/rebuild": "^3.7.0"
  },
  "build": {
    "appId": "com.noctua.ide",
    "productName": "NOCTUA",
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  }
}
